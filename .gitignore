# This repository uses an allowlist so miscellaneous local files cannot be
# staged accidentally. When adding a new public project file, explicitly
# unignore it here and review it before committing.
/*

# Public top-level project files.
!/.gitignore
!/.gitattributes
!/.gitleaks.toml
!/.github/
/.github/*
!/.github/ISSUE_TEMPLATE/
/.github/ISSUE_TEMPLATE/*
!/.github/ISSUE_TEMPLATE/bug.yml
!/.github/ISSUE_TEMPLATE/config.yml
!/.github/ISSUE_TEMPLATE/feature.yml
!/.github/ISSUE_TEMPLATE/portability.yml
!/.github/pull_request_template.md
!/.github/workflows/
/.github/workflows/*
!/.github/workflows/test.yml
!/CONTRIBUTING.md
!/README.md
!/SECURITY.md
!/LICENSE
!/TODO.md
!/justfile
!/lair
!/analysis.sh
!/bootstrap.sh
!/build-hermes-image.sh
!/doctor.sh
!/get-repo.sh
!/local-models.sh
!/run.sh
!/slot-run.sh
!/profile-read.sh

# Public configuration and container-workspace files. Ignore new files within
# these directories until they have been deliberately reviewed and allowlisted.
!/gateway/
/gateway/*
!/gateway/openrouter.conf.template

!/profiles/
/profiles/*
!/profiles/default.conf
!/profiles/flat.conf
!/profiles/capabilities/
/profiles/capabilities/*
!/profiles/capabilities/schema.json
!/profiles/capabilities/*.json

!/workspace/
/workspace/*
!/workspace/AGENTS.md

# Source-pinned image metadata and reviewed build patches.
!/images/
/images/*
!/images/hermes/
/images/hermes/*
!/images/hermes/metadata.conf
!/images/hermes/0001-fix-honor-explicit-local-model-runtime.patch
!/images/hermes/podman.patch

# Declarative, non-executable local-model profiles are contribution-friendly:
# adding a reviewed JSON profile does not require another .gitignore change.
!/local-models/
/local-models/*
!/local-models/README.md
!/local-models/profile.schema.json
!/local-models/profiles/
/local-models/profiles/*
!/local-models/profiles/*.json

# Design and implementation documentation.
!/docs/
/docs/*
!/docs/design.md
!/docs/implementation.md
!/docs/code-review-capability-profiles.md
!/docs/open-source-release-plan.md
!/docs/publication-audit.md

!/tests/
/tests/*
!/tests/local-models.sh
!/tests/lair.sh
!/tests/run-safe-roots.sh
!/tests/capability-profiles.sh
!/tests/run-capability-args.sh
!/tests/release-tools.sh
