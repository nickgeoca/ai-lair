             model = model_override
         if provider_override:
             requested_provider = provider_override
-        runtime = _resolve_runtime_with_fallback({
+        resolve_kwargs = {
             "requested": requested_provider,
             "target_model": model or None,
-        })
+        }
+        if startup_base_url:
+            resolve_kwargs["explicit_base_url"] = startup_base_url
+        if launcher_api_key:
+            resolve_kwargs["explicit_api_key"] = launcher_api_key
+        runtime = _resolve_runtime_with_fallback(resolve_kwargs)
+        if startup_base_url:
+            runtime["base_url"] = startup_base_url
+        if launcher_api_key:
+            runtime["api_key"] = launcher_api_key
     _pr = _load_provider_routing()
     return AIAgent(
         model=model,
